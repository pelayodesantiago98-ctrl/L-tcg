# Secretos: clave de la API, secreto JWT y clave de registro.
.env

# Datos de los usuarios: sus colecciones, sus álbumes y sus cuentas.
data/l-tcg.sqlite3
data/l-tcg.sqlite3-wal
data/l-tcg.sqlite3-shm

# Cache de imagenes. Una carta ronda los 15 KB en baja y 150 KB en alta; con
# el catalogo entero esto llega a varios GB y ademas se regenera solo.
data/imagenes/

node_modules/
npm-debug.log*
*.tmp

# Restos del primer intento de generar iconos con rsvg, que no esta instalado.
# Los PNG los produce herramientas-iconos.js, que es la fuente de verdad.
public/img/*.svg

# Copias de seguridad que deja el trabajo en el servidor. Nunca al repositorio:
# entre ellas hay volcados de ficheros de configuración con credenciales.
*.bak
*.bak[0-9]
*.pre-*

# Copias que se dejan al tocar un fichero a mano (server.js.antes-algo-20260813).
# Sirven para volver atras en el momento, no son el proyecto.
*.antes-*
*.pre-*
*.pre-*.bak

# El tema que elige cada usuario. Es suyo, como su coleccion.
data/temas.json
